# Optional: compose.yaml works without a .env. To customize, save this file as .env next to compose.yaml and
# edit it. Never commit .env.

# The image to run. Default: ghcr.io/gedigi/chartmate:latest. Uncomment to pin a version (e.g. :1.0.0), a
# version and digest (:1.0.0@sha256:…, see the README's Security section) or your own build
# (docker build -t chartmate:local .).
# CHARTMATE_IMAGE=ghcr.io/gedigi/chartmate:latest

# Published address and port. 127.0.0.1 = this machine only (e.g. behind a reverse proxy on the same host);
# 0.0.0.0 = every interface (set a password below first).
CHARTMATE_BIND=127.0.0.1
CHARTMATE_PORT=8787

# Login. Leave empty for no login (fine on loopback only); otherwise at least 12 characters (a value of only
# spaces is refused). Changing the password signs every session out.
CHARTMATE_PASSWORD=
# Cookie signing secret. Empty = a random one generated once and kept in the database (fine for most installs);
# set one (openssl rand -hex 32) to keep sessions valid across a database restore or several instances.
CHARTMATE_SESSION_SECRET=

# Behind a reverse proxy: trusted hop count (1 for a single proxy), true, or an IP/CIDR list.
CHARTMATE_TRUST_PROXY=

# Hostnames the server answers to besides localhost, 127.0.0.1 and [::1], comma-separated, without scheme or
# port (e.g. chartmate.example.com,192.168.1.10). Without a password, any other Host is refused (403), which
# blocks DNS rebinding; with a password, a non-empty list is enforced too.
CHARTMATE_ALLOWED_HOSTS=

# Crypto data source: binance or coinbase.
CRYPTO_PROVIDER=binance
# Another Binance-compatible endpoint, e.g. where the default is blocked (https:// only). Empty = the default
# (https://data-api.binance.vision).
BINANCE_BASE_URL=

# Postgres instead of SQLite (the bundled postgres service): set a password without URL special characters
# (openssl rand -hex 24 works) and uncomment the two lines below it. Data is not copied over from SQLite.
POSTGRES_PASSWORD=
# COMPOSE_PROFILES=postgres
# DATABASE_URL=postgres://chartmate:${POSTGRES_PASSWORD}@postgres:5432/chartmate
