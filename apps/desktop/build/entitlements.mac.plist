<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the main app binary. Kept to the minimum:
  - allow-jit: V8 (main process and renderers) JIT-compiles JavaScript into MAP_JIT memory; without it the
    hardened runtime kills the process. No other exception is needed:
    * no allow-unsigned-executable-memory (V8 uses MAP_JIT, not plain RWX pages);
    * no disable-library-validation (no native Node modules: SQLite is Node's built-in node:sqlite);
    * no network/device/camera entitlements (outbound HTTPS needs none outside the App Sandbox).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
