{
  "name": "@chartmate/server",
  "version": "1.0.0",
  "description": "Chartmate API server (Fastify + Kysely over SQLite or Postgres); also serves the web build.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chartmate/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "yahoo-finance2": "4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
