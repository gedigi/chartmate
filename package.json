{
  "name": "chartmate", "private": true, "type": "module",
  "description": "Self-hosted, single-user charting app for stocks, crypto and custom baskets (pnpm workspace root).",
  "pnpm": { "neverBuiltDependencies": ["better-sqlite3"] },
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "dev": "pnpm -r --parallel dev",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": { "@playwright/test": "1.64.0", "typescript": "~5.9.3", "vitest": "5.0.3", "@types/node": "^22" }
}
