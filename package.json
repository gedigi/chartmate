{
  "name": "chartmate",
  "private": true,
  "type": "module",
  "description": "Chartmate: a single-user charting app for US stocks, crypto and custom baskets, as a desktop app or self-hosted (pnpm workspace root).",
  "license": "AGPL-3.0-only",
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@8.15.9+sha512.499434c9d8fdd1a2794ebf4552b3b25c0a633abcee5bb15e7b5de90f32f47b513aca98cd5cfd001c31f0db454bc3804edccd578501e4ca293a6816166bbd9f81",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "dev": "pnpm -r --parallel dev",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "new:indicator": "node scripts/new-indicator.mjs",
    "licenses:check": "node scripts/third-party-notices.mjs --profile=server --check && node scripts/third-party-notices.mjs --profile=desktop --check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  }
}
