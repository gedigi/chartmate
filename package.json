{
  "name": "chartmate",
  "private": true,
  "type": "module",
  "description": "Chartmate: a single-user charting app for US stocks, crypto and custom baskets, as a desktop app or self-hosted (pnpm workspace root).",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "dev": "pnpm -r --parallel dev",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "new:indicator": "node scripts/new-indicator.mjs",
    "licenses:check": "node scripts/third-party-notices.mjs --profile=server --check && node scripts/third-party-notices.mjs --profile=desktop --check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vitest": "5.0.4"
  }
}
