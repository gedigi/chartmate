{
  "name": "chartmate",
  "private": true,
  "type": "module",
  "description": "Self-hosted, single-user charting app for stocks, crypto and custom baskets (pnpm workspace root).",
  "license": "AGPL-3.0-only",
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "dev": "pnpm -r --parallel dev",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22",
    "typescript": "~7.0.2",
    "vitest": "5.0.3"
  }
}
